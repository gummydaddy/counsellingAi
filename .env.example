# Environment Variables for Vercel Deployment
# Go to Vercel Dashboard > Your Project > Settings > Environment Variables
# Add the following variables:

# Option 1: Generic API Key (auto-detects provider based on key format)
VITE_API_KEY=your_api_key_here

# Option 2: Provider-specific keys (uncomment and use one)
# VITE_GEMINI_API_KEY=your_gemini_api_key
# VITE_OPENAI_API_KEY=your_openai_api_key
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key
# VITE_GROQ_API_KEY=your_groq_api_key
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# Kira AI Configuration
VITE_KIRA_API_KEY=your_kira_api_key
VITE_KIRA_MODEL=minimax-m3-free

# Django Backend Configuration (for PostgreSQL)
# PostgreSQL Database
DB_NAME=mindpath
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=prefer  # require for managed PostgreSQL (Supabase, Neon, RDS)

# Django Security
DJANGO_SECRET_KEY=your_django_secret_key_here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com

# JWT Signing Key (for API authentication)
JWT_SIGNING_KEY=your_jwt_signing_key_here

# Optional: Redis for caching/sessions
# REDIS_URL=redis://localhost:6379/0

# Optional: S3 Storage
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket
# AWS_S3_REGION_NAME=us-east-1

