# Environment Variables for Vercel (Frontend) + Render (Backend) Deployment
# ============================================================================

# --- FRONTEND (Vercel) ---
# Go to Vercel Dashboard > Your Project > Settings > Environment Variables

# AI Provider API Keys (Frontend uses these directly via browser)
# Option 1: Generic API Key (auto-detects provider based on key format)
VITE_API_KEY=your_api_key_here

# Option 2: Provider-specific keys (uncomment and use one)
# VITE_GEMINI_API_KEY=your_gemini_api_key
# VITE_OPENAI_API_KEY=your_openai_api_key
# VITE_ANTHROPIC_API_KEY=your_anthropic_api_key
# VITE_GROQ_API_KEY=your_groq_api_key
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key

# Kira AI Configuration
VITE_KIRA_API_KEY=your_kira_api_key
VITE_KIRA_MODEL=minimax-m3-free

# Backend API URL (IMPORTANT: Set this to your Render backend URL)
# Development: leave empty (uses Vite proxy to localhost:8000)
# Production: https://your-backend-name.onrender.com/api/common
VITE_API_BASE_URL=https://your-backend-name.onrender.com/api/common

# --- BACKEND (Render) ---
# Go to Render Dashboard > Your Web Service > Environment

# Django Security
DJANGO_SECRET_KEY=generate-with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-backend-name.onrender.com,yourdomain.com

# CORS - Vercel Frontend Origin (REQUIRED for cross-origin requests)
VERCEL_ORIGIN=https://your-frontend-name.vercel.app

# JWT Signing Key (for API authentication)
JWT_SIGNING_KEY=generate-secure-random-string-32-chars-min

# PostgreSQL Database (Render provides this automatically)
# DATABASE_URL is provided by Render PostgreSQL addon
# Or set individually:
# DB_NAME=mindpath
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=your-postgres-host
# DB_PORT=5432
# DB_SSLMODE=require

# Optional: Redis for caching/sessions (Render Redis addon)
# REDIS_URL=redis://localhost:6379/0

# Optional: S3 Storage for media files
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_STORAGE_BUCKET_NAME=your_bucket
# AWS_S3_REGION_NAME=us-east-1

# --- LOCAL DEVELOPMENT (.env.local) ---
# Copy this to .env.local and customize:
# VITE_API_KEY=your_local_key
# VITE_API_BASE_URL=/api/common  # Uses Vite proxy
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# VERCEL_ORIGIN=http://localhost:5173

